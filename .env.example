# Скопируйте этот файл в .env и заполните своими значениями

# Подключение к PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lamiacrm

# Порт, на котором запускается сервер
PORT=3000

# Секрет для подписи сессионных cookie (любая длинная случайная строка)
SESSION_SECRET=change_this_to_a_random_secret_string
